<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Elevator list
         ================================================================ -->
    <template id="portal_my_equipment" name="My Elevators">
        <t t-call="portal.portal_layout">
            <t t-set="title">Mina hissar</t>
            <div class="container">
                <t t-if="not elevators">
                    <div class="alert alert-info mt-3">
                        Inga hissar är kopplade till ert konto ännu.
                    </div>
                </t>
                <div class="row mt-3">
                    <t t-foreach="elevators" t-as="equipment">
                        <div class="col-md-6 mb-3">
                            <div class="card h-100">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">
                                        <t t-esc="equipment.elevator_number or equipment.name"/>
                                    </h5>
                                    <span t-attf-class="badge bg-#{'success' if equipment.lifecycle_stage == 'ok' else 'warning' if equipment.lifecycle_stage in ('inspection_due', 'service_due') else 'danger'}">
                                        <t t-esc="dict(equipment._fields['lifecycle_stage'].selection).get(equipment.lifecycle_stage)"/>
                                    </span>
                                </div>
                                <div class="card-body">
                                    <p class="mb-1">
                                        <strong>Adress:</strong>
                                        <t t-esc="equipment.partner_id.street or ''"/>
                                        <t t-esc="equipment.partner_id.city or ''"/>
                                    </p>
                                    <p class="mb-1">
                                        <strong>Senaste besiktning:</strong>
                                        <t t-esc="equipment.last_inspection_date or '–'"/>
                                    </p>
                                    <p class="mb-1" t-if="equipment.next_inspection_date">
                                        <strong>Nästa besiktning:</strong>
                                        <t t-esc="equipment.next_inspection_date"/>
                                    </p>
                                    <p class="mb-1" t-if="equipment.operational_status == 'out_of_order'">
                                        <span class="text-danger">
                                            <i class="fa fa-exclamation-triangle"/> Ur drift sedan
                                            <t t-esc="equipment.out_of_order_date"/>
                                        </span>
                                    </p>
                                </div>
                                <div class="card-footer d-flex gap-2">
                                    <a t-attf-href="/my/equipment/#{equipment.id}"
                                       class="btn btn-sm btn-primary">Visa detaljer</a>
                                    <a t-attf-href="/my/equipment/#{equipment.id}/report"
                                       class="btn btn-sm btn-outline-danger">Felanmälan</a>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
                <div t-if="pager" class="mt-3">
                    <t t-call="portal.pager"/>
                </div>
            </div>
        </t>
    </template>

    <!-- ================================================================
         Elevator detail
         ================================================================ -->
    <template id="portal_equipment_detail" name="Elevator Detail">
        <t t-call="portal.portal_layout">
            <t t-set="title">Hissdetaljer</t>
            <div class="container">
                <nav aria-label="breadcrumb" class="mt-3">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="/my/equipment">Mina hissar</a>
                        </li>
                        <li class="breadcrumb-item active">
                            <t t-esc="equipment.elevator_number or equipment.name"/>
                        </li>
                    </ol>
                </nav>

                <div class="card mb-3">
                    <div class="card-header">
                        <h4 class="mb-0">
                            <t t-esc="equipment.elevator_number or equipment.name"/>
                        </h4>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Typ:</strong>
                                    <t t-esc="equipment.elevator_type_id.name or '–'"/></p>
                                <p><strong>Tillverkningsnummer:</strong>
                                    <t t-esc="equipment.manufacturing_number or '–'"/></p>
                                <p><strong>Driftstatus:</strong>
                                    <t t-esc="dict(equipment._fields['operational_status'].selection).get(equipment.operational_status)"/></p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Senaste besiktning:</strong>
                                    <t t-esc="equipment.last_inspection_date or '–'"/></p>
                                <p><strong>Nästa besiktning:</strong>
                                    <t t-esc="equipment.next_inspection_date or '–'"/></p>
                                <p t-if="contract">
                                    <strong>Serviceavtal:</strong>
                                    <t t-esc="contract.visits_per_year"/> besök/år,
                                    responstid <t t-esc="contract.response_time_hours"/> h
                                </p>
                            </div>
                        </div>
                        <a t-attf-href="/my/equipment/#{equipment.id}/report"
                           class="btn btn-danger">
                            <i class="fa fa-exclamation-triangle"/> Felanmälan
                        </a>
                    </div>
                </div>

                <h5>Besiktningsprotokoll</h5>
                <t t-if="not inspections">
                    <p class="text-muted">Inga genomförda besiktningar ännu.</p>
                </t>
                <table t-if="inspections" class="table table-sm">
                    <thead class="table-light">
                        <tr>
                            <th>Datum</th>
                            <th>Typ</th>
                            <th>Resultat</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="inspections" t-as="inspection">
                            <tr>
                                <td><t t-esc="inspection.date"/></td>
                                <td><t t-esc="dict(inspection._fields['inspection_type'].selection).get(inspection.inspection_type)"/></td>
                                <td>
                                    <span t-attf-class="badge bg-#{'success' if inspection.remark_level == 'none' else 'warning' if inspection.remark_level == 'remark' else 'danger'}">
                                        <t t-esc="dict(inspection._fields['remark_level'].selection).get(inspection.remark_level)"/>
                                    </span>
                                </td>
                                <td>
                                    <a t-attf-href="/my/equipment/#{equipment.id}/inspection/#{inspection.id}/pdf"
                                       class="btn btn-sm btn-outline-secondary">
                                        <i class="fa fa-file-pdf-o"/> Protokoll
                                    </a>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <!-- ================================================================
         Fault report form (logged in)
         ================================================================ -->
    <template id="portal_report_form" name="Report Fault">
        <t t-call="portal.portal_layout">
            <t t-set="title">Felanmälan</t>
            <div class="container">
                <h4 class="mt-3">Felanmälan —
                    <t t-esc="equipment.elevator_number or equipment.name"/></h4>
                <div t-if="error == 'missing'" class="alert alert-warning">
                    Beskriv felet innan du skickar.
                </div>
                <form t-attf-action="/my/equipment/#{equipment.id}/report/submit"
                      method="post" class="mt-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="mb-3">
                        <label for="description" class="form-label">Vad har hänt?</label>
                        <textarea name="description" id="description" rows="5"
                                  class="form-control" required="required"
                                  placeholder="Beskriv felet så noggrant du kan..."/>
                    </div>
                    <button type="submit" class="btn btn-danger">Skicka felanmälan</button>
                    <a t-attf-href="/my/equipment/#{equipment.id}"
                       class="btn btn-link">Avbryt</a>
                </form>
            </div>
        </t>
    </template>

    <!-- ================================================================
         Fault report by QR token (no login)

         A tenant has no account. The token identifies the elevator and
         nothing else — this page shows the elevator's name and asks what
         is wrong, no history, no contract, no address beyond what is on
         the sticker.
         ================================================================ -->
    <template id="portal_report_token" name="Report Fault (QR)">
        <t t-call="portal.portal_layout">
            <t t-set="title">Felanmälan</t>
            <div class="container">
                <div class="card mt-3">
                    <div class="card-header">
                        <h4 class="mb-0">Felanmälan —
                            <t t-esc="equipment.elevator_number or equipment.name"/></h4>
                    </div>
                    <div class="card-body">
                        <div t-if="error == 'missing'" class="alert alert-warning">
                            Beskriv felet innan du skickar.
                        </div>
                        <form t-attf-action="/my/equipment/report/#{token}/submit"
                              method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="mb-3">
                                <label for="description" class="form-label">Vad har hänt?</label>
                                <textarea name="description" id="description" rows="5"
                                          class="form-control" required="required"
                                          placeholder="Beskriv felet så noggrant du kan..."/>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label for="reporter_name" class="form-label">Ditt namn (frivilligt)</label>
                                    <input type="text" name="reporter_name" id="reporter_name"
                                           class="form-control"/>
                                </div>
                                <div class="col-md-6">
                                    <label for="reporter_phone" class="form-label">Telefon (frivilligt)</label>
                                    <input type="tel" name="reporter_phone" id="reporter_phone"
                                           class="form-control"/>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-danger btn-lg w-100">
                                Skicka felanmälan
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ================================================================
         Confirmation
         ================================================================ -->
    <template id="portal_report_done" name="Fault Reported">
        <t t-call="portal.portal_layout">
            <t t-set="title">Felanmälan skickad</t>
            <div class="container">
                <div class="alert alert-success mt-3">
                    <h4 class="alert-heading">Tack — felanmälan är skickad.</h4>
                    <p class="mb-0">
                        Vi har tagit emot din anmälan för
                        <strong><t t-esc="equipment.elevator_number or equipment.name"/></strong>
                        och en tekniker kontaktar er.
                    </p>
                </div>
                <a t-if="not from_token" href="/my/equipment" class="btn btn-primary">
                    Tillbaka till mina hissar
                </a>
            </div>
        </t>
    </template>

    <!-- ================================================================
         Inspection protocol PDF

         Deliberately plain: a header, the elevator, the points and their
         results, a signature line. elevator_report overrides this template
         with the branded version — the portal must work without it.
         ================================================================ -->
    <template id="report_inspection_protocol" name="Inspection Protocol">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="inspection">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Besiktningsprotokoll</h2>
                        <div class="row mt-4">
                            <div class="col-6">
                                <p><strong>Protokoll:</strong> <t t-esc="inspection.name"/></p>
                                <p><strong>Datum:</strong> <t t-esc="inspection.date"/></p>
                                <p><strong>Besiktningsman:</strong>
                                    <t t-esc="inspection.inspector_id.name"/></p>
                            </div>
                            <div class="col-6">
                                <p><strong>Hiss:</strong>
                                    <t t-esc="inspection.equipment_id.elevator_number or inspection.equipment_id.name"/></p>
                                <p><strong>Tillverkningsnummer:</strong>
                                    <t t-esc="inspection.equipment_id.manufacturing_number or '–'"/></p>
                                <p><strong>Besiktningsorgan:</strong>
                                    <t t-esc="inspection.inspection_body_id.name or '–'"/></p>
                            </div>
                        </div>

                        <table class="table table-sm mt-4">
                            <thead>
                                <tr>
                                    <th style="width:8%">Nr</th>
                                    <th>Kontrollpunkt</th>
                                    <th style="width:18%">Resultat</th>
                                    <th style="width:25%">Anmärkning</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="counter" t-value="0"/>
                                <t t-foreach="inspection.line_ids.sorted('sequence')" t-as="line">
                                    <t t-set="counter" t-value="counter + 1"/>
                                    <tr>
                                        <td><t t-esc="counter"/></td>
                                        <td><t t-esc="line.name"/></td>
                                        <td>
                                            <t t-if="line.result == 'ok'">OK</t>
                                            <t t-elif="line.result == 'remark'">Anmärkning</t>
                                            <t t-elif="line.result == 'red_remark'">Röd anmärkning</t>
                                            <t t-else="">Ej tillämplig</t>
                                        </td>
                                        <td><t t-esc="line.note or ''"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="mt-4">
                            <p>
                                <strong>Sammanvägd bedömning:</strong>
                                <t t-if="inspection.remark_level == 'none'">Inga anmärkningar</t>
                                <t t-elif="inspection.remark_level == 'remark'">
                                    Anmärkning (<t t-esc="inspection.remark_count"/> st)
                                </t>
                                <t t-else="">
                                    Röd anmärkning — hissen får inte användas
                                </t>
                            </p>
                        </div>

                        <div t-if="inspection.notes" class="mt-3">
                            <strong>Övriga noteringar</strong>
                            <div t-field="inspection.notes"/>
                        </div>

                        <div class="row mt-5">
                            <div class="col-6">
                                <div style="border-top:1px solid #000; padding-top:4px;">
                                    Besiktningsman
                                </div>
                            </div>
                            <div class="col-6">
                                <div style="border-top:1px solid #000; padding-top:4px;">
                                    Datum
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
