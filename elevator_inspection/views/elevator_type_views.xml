<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Inspection settings on the elevator type.

         BFS 2011:12 sets one year for most elevators and two for some. The
         interval belongs on the type, not on each elevator: 400 elevators
         of the same type share it.
         ================================================================ -->
    <record id="elevator_type_form_inspection" model="ir.ui.view">
        <field name="name">elevator.type.form.inspection</field>
        <field name="model">elevator.type</field>
        <field name="inherit_id" ref="elevator_base.elevator_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <group string="Inspection">
                    <field name="inspection_template_id"
                           options="{'no_create': True}"/>
                    <field name="inspection_interval_months"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
