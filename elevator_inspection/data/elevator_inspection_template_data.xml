        <field name="inspection_type">statutory</field>
        <field name="elevator_type_id" ref="elevator_base.elevator_type_stair_lift"/>
        <field name="interval_months">12</field>
    </record>
    <record id="template_stair_lift_1" model="maintenance.inspection.template.line">
        <field name="template_id" ref="template_stair_lift"/>
        <field name="sequence">10</field>
        <field name="name">Säkerhetsanordning — hinderdetektering</field>
    </record>
    <record id="template_stair_lift_2" model="maintenance.inspection.template.line">
        <field name="template_id" ref="template_stair_lift"/>
        <field name="sequence">20</field>
        <field name="name">Säkerhetsbälte och fäste</field>
    </record>
    <record id="template_stair_lift_3" model="maintenance.inspection.template.line">
        <field name="template_id" ref="template_stair_lift"/>
        <field name="sequence">30</field>
        <field name="name">Skena och infästning i trappan</field>
    </record>
    <record id="template_stair_lift_4" model="maintenance.inspection.template.line">
        <field name="template_id" ref="template_stair_lift"/>
        <field name="sequence">40</field>
        <field name="name">Broms och parkeringsläge</field>
    </record>
    <record id="template_stair_lift_5" model="maintenance.inspection.template.line">
