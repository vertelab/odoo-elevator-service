    <!-- ── Generell, alla typer ────────────────────────────────────────── -->
    <record id="template_generic" model="maintenance.inspection.template">
        <field name="name">BFS-besiktning — Allmän</field>
        <field name="inspection_type">statutory</field>
        <field name="interval_months">12</field>
        <field name="description">Används när hisstypen saknar egen mall.</field>
    </record>
    <record id="template_generic_1" model="maintenance.inspection.template.line">
        <field name="template_id" ref="template_generic"/>
        <field name="sequence">10</field>
        <field name="name">Broms — funktion</field>
    </record>
    <record id="template_generic_2" model="maintenance.inspection.template.line">
        <field name="template_id" ref="template_generic"/>
        <field name="sequence">20</field>
        <field name="name">Dörrlås och dörrkontakt</field>
    </record>
    <record id="template_generic_3" model="maintenance.inspection.template.line">
        <field name="template_id" ref="template_generic"/>
        <field name="sequence">30</field>
        <field name="name">Nödtelefon — funktion</field>
    </record>
    <record id="template_generic_4" model="maintenance.inspection.template.line">
        <field name="template_id" ref="template_generic"/>
        <field name="sequence">40</field>
        <field name="name">Nödbelysning</field>
    </record>
    <record id="template_generic_5" model="maintenance.inspection.template.line">
        <field name="template_id" ref="template_generic"/>
        <field name="sequence">50</field>
        <field name="name">Skyltar och märkning</field>
        <field name="allow_red_remark" eval="False"/>
    </record>


    <!-- ================================================================
         Link the templates to their elevator types.

         Done here rather than on the elevator.type records: elevator_base
         does not know that inspection templates exist, and putting the
         reference there would make the base module depend on this one.
         ================================================================ -->
    <function model="elevator.type" name="write">
        <value eval="[ref('elevator_base.elevator_type_traction')]"/>
        <value eval="{'inspection_template_id': ref('template_traction'), 'inspection_interval_months': 12}"/>
    </function>
    <function model="elevator.type" name="write">
        <value eval="[ref('elevator_base.elevator_type_hydraulic')]"/>
        <value eval="{'inspection_template_id': ref('template_hydraulic'), 'inspection_interval_months': 12}"/>
    </function>
    <function model="elevator.type" name="write">
        <value eval="[ref('elevator_base.elevator_type_mrl')]"/>
        <value eval="{'inspection_template_id': ref('template_mrl'), 'inspection_interval_months': 12}"/>
    </function>
    <function model="elevator.type" name="write">
        <value eval="[ref('elevator_base.elevator_type_stair_lift')]"/>
        <value eval="{'inspection_template_id': ref('template_stair_lift'), 'inspection_interval_months': 12}"/>
    </function>

</odoo>
