<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Elevator types, control systems and door types.

         Configuration, not data entry: a service company picks from a list,
         it does not invent a type per elevator. Kept in their own file so
         the menu file stays a menu file.
         ================================================================ -->

    <!-- Elevator type -->
    <record id="elevator_type_list" model="ir.ui.view">
        <field name="name">elevator.type.list</field>
        <field name="model">elevator.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="elevator_type_form" model="ir.ui.view">
        <field name="name">elevator.type.form</field>
        <field name="model">elevator.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="elevator_type_search" model="ir.ui.view">
        <field name="name">elevator.type.search</field>
        <field name="model">elevator.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Control system -->
    <record id="elevator_control_system_list" model="ir.ui.view">
        <field name="name">elevator.control.system.list</field>
        <field name="model">elevator.control.system</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="manufacturer"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="elevator_control_system_form" model="ir.ui.view">
        <field name="name">elevator.control.system.form</field>
        <field name="model">elevator.control.system</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="manufacturer"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Door type -->
    <record id="elevator_door_type_list" model="ir.ui.view">
        <field name="name">elevator.door.type.list</field>
        <field name="model">elevator.door.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="elevator_door_type_form" model="ir.ui.view">
        <field name="name">elevator.door.type.form</field>
        <field name="model">elevator.door.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
