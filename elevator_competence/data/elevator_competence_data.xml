<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ================================================================
         Elevator-specific competence links.

         The certifications themselves are seeded by the odoo-hr bridges:

             hr_certificate_hiss       Hissinstallation, Hissbesiktning,
                                       Hisservice — felsökning
             hr_certificate_esa        Elsäkerhet, Arbete i elanläggning,
                                       Elsäkerhet vid arbete i hiss
             hr_certificate_arbetsmiljo Heta arbeten, Fallskydd,
                                       Säkerhetsutbildning, Tunga lyft, OSA

         This module does not duplicate them. What it adds is the set an
         elevator technician needs, so a job position can require it and a
         technician can be checked against it.
         ================================================================ -->

    <!-- The baseline every elevator technician must hold. The individual
         skills come from the odoo-hr bridges; this is the bundle that says
         "these together make a technician". -->
    <record id="skill_elevator_baseline" model="hr.skill">
        <field name="name">Baskrav hissmontör</field>
        <field name="skill_type_id" ref="hr_certificate_hiss.skill_type_hiss"/>
    </record>

</odoo>
