<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Service agreement on the elevator form.

         Anchored on //notebook, not on a named page: elevator_base,
         elevator_inspection and elevata_fsm_flow all extend this form.
         ================================================================ -->
    <record id="maintenance_equipment_form_contract" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.contract</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_service_contracts" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="not service_contract_ids">
                    <span class="o_stat_text">Agreements</span>
                </button>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Service Agreement" name="service_agreement"
                      invisible="not is_elevator">
                    <group>
                        <group>
                            <field name="is_elevator" invisible="1"/>
                            <field name="elevator_service_contract_id"
                                   options="{'no_create': True}"/>
                            <field name="contract_visits_per_year"/>
                            <field name="contract_response_time_hours"/>
                        </group>
                    </group>
                    <field name="service_contract_ids">
                        <list>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="coverage" widget="badge"/>
                            <field name="visits_per_year"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="active" widget="boolean_toggle"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
